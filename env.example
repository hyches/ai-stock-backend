# AI Stock Trading System - Environment Configuration
# Copy this file to .env and fill in your actual values

# =============================================================================
# STOCK DATA APIs (Multiple providers for fallback & redundancy)
# =============================================================================

# Alpha Vantage API (Free tier: 5 calls/min, 500/day)
# Get key: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here

# Finnhub API (Free tier: 60 calls/min)
# Get key: https://finnhub.io/dashboard
FINNHUB_API_KEY=your_finnhub_key_here

# Financial Modeling Prep API (Free tier: 250 calls/day)
# Get key: https://financialmodelingprep.com/
FMP_API_KEY=your_fmp_key_here

# Yahoo Finance (No key needed, wrapped by yfinance)
YAHOO_FINANCE_API_KEY=optional_yahoo_key

# =============================================================================
# TRADING APIs (Optional - For Live Trading)
# =============================================================================

# Zerodha (Indian market)
ZERODHA_API_KEY=your_zerodha_key_here
ZERODHA_API_SECRET=your_zerodha_secret_here

# Interactive Brokers (Global markets)
IB_API_KEY=your_ib_key_here
IB_API_SECRET=your_ib_secret_here

# Alpaca (US markets)
ALPACA_API_KEY=your_alpaca_key_here
ALPACA_API_SECRET=your_alpaca_secret_here

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# SQLite (Default for development)
DATABASE_URL=sqlite:///./test.db

# PostgreSQL (For production)
# DATABASE_URL=postgresql://username:password@localhost:5432/stock_trading

# =============================================================================
# SECURITY SETTINGS
# =============================================================================

# Generate a secure secret key
SECRET_KEY=your_secret_key_here

# API Key for external API access
API_KEY=your_api_key_here

# JWT Settings
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# Server settings
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
DEBUG=true
ENVIRONMENT=development

# CORS origins (comma-separated)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# =============================================================================
# REDIS CONFIGURATION (Optional)
# =============================================================================

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# =============================================================================
# TRADING SETTINGS
# =============================================================================

# Enable/disable live trading
TRADING_ENABLED=false

# Risk management
MAX_POSITION_SIZE=100000.0
RISK_FREE_RATE=0.02
MAX_LEVERAGE=3.0
DEFAULT_RISK_PER_TRADE=0.02

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================

LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# =============================================================================
# MONITORING (Optional)
# =============================================================================

ENABLE_METRICS=true
PROMETHEUS_MULTIPROC_DIR=./metrics

# =============================================================================
# RATE LIMITING
# =============================================================================

RATE_LIMIT_WINDOW=60
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_BY_IP=true
RATE_LIMIT_BY_USER=true

# =============================================================================
# RESEARCH TAB ENHANCEMENTS (Caching & Multi-Provider)
# =============================================================================

# Enable caching globally
CACHE_ENABLED=true

# Cache TTL (Time-To-Live) in seconds per data type
RESEARCH_CACHE_TTL_INFO=3600           # 1 hour (company info)
RESEARCH_CACHE_TTL_HISTORY=300         # 5 minutes (price history)
RESEARCH_CACHE_TTL_NEWS=600            # 10 minutes (news articles)
RESEARCH_CACHE_TTL_TECHNICALS=300      # 5 minutes (technical indicators)
RESEARCH_CACHE_TTL_FINANCIALS=86400    # 24 hours (financial statements)

# Rate limits per provider (calls per minute or day)
RATE_LIMIT_ENABLED=true
ALPHAVANTAGE_RATE_LIMIT=5              # 5 calls/min
FINNHUB_RATE_LIMIT=60                  # 60 calls/min
FMP_RATE_LIMIT=250                     # 250 calls/day
