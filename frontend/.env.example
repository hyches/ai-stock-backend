# API Configuration
# Backend API URL
VITE_API_BASE_URL=http://localhost:8000
VITE_API_VERSION=/api/v1

# WebSocket Configuration
# WebSocket URL for real-time updates
VITE_WS_URL=ws://localhost:8000/ws

# Feature Flags
# Enable/Disable trading features in UI
VITE_ENABLE_TRADING=true
# Enable/Disable ML predictions in UI
VITE_ENABLE_ML=true
# Enable/Disable Alert system in UI
VITE_ENABLE_ALERTS=true
# Enable/Disable Backup functionality
VITE_ENABLE_BACKUP=true

# UI Configuration
# Default theme (light/dark)
VITE_DEFAULT_THEME=light
# Default language code
VITE_DEFAULT_LANGUAGE=en

# Development
# Enable debug logging
VITE_DEBUG=false
# Use mock API responses instead of real backend
VITE_MOCK_API=false

# Trading Configuration
# Default risk level for new strategies (low/medium/high)
VITE_DEFAULT_RISK_LEVEL=medium
# Maximum position size in currency units
VITE_MAX_POSITION_SIZE=10000
# Default stop loss percentage (e.g., 0.02 for 2%)
VITE_DEFAULT_STOP_LOSS=0.02

# ML Configuration
# Model version to display/use
VITE_ML_MODEL_VERSION=1.0.0
# Minimum confidence threshold for displaying predictions
VITE_PREDICTION_CONFIDENCE_THRESHOLD=0.7

# Notifications
# Enable browser push notifications
VITE_ENABLE_PUSH_NOTIFICATIONS=false
# Enable email notifications (requires backend config)
VITE_ENABLE_EMAIL_NOTIFICATIONS=false

# Performance
# Data cache duration in milliseconds
VITE_CACHE_DURATION=300000
# API request timeout in milliseconds
VITE_REQUEST_TIMEOUT=30000
# Maximum number of retries for failed requests
VITE_MAX_RETRIES=3
